# ===================================================================
# ZaraOS inittab - Auto-login Configuration
# ===================================================================
# Works on both Raspberry Pi 5 and QEMU:
#   Pi 5: serial on ttyAMA10, HDMI on tty1
#   QEMU: serial on ttyAMA0 (-nographic), display on tty1 (--gui)
#
# Format: id:runlevels:action:process
# ===================================================================

# System initialization
::sysinit:/etc/init.d/rcS

# Serial console — Pi 5 uses ttyAMA10, QEMU uses ttyAMA0
# BusyBox init ignores entries for non-existent ttys, so both are safe.
ttyAMA10::respawn:/sbin/getty -n -L -l /usr/bin/autologin.sh ttyAMA10 115200 vt100
ttyAMA0::respawn:/sbin/getty -n -L -l /usr/bin/autologin.sh ttyAMA0 115200 vt100

# HDMI / graphical console — gated by startup wizard on first boot
# startup-gate.sh defers getty until the setup UI finishes (DRM exclusive).
# On subsequent boots it immediately execs getty (no overhead).
tty1::respawn:/usr/bin/startup-gate.sh

# Stuff to do for the 3-finger salute
::ctrlaltdel:/sbin/reboot

# Stuff to do before rebooting
::shutdown:/etc/init.d/rcK
::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r
