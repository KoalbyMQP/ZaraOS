{
  "version": 1,
  "packages": [
    {
      "name": "cortex-bridge",
      "image": "koalby/cortex-bridge",
      "version": "latest",
      "essential": true,
      "autostart": true,
      "priority": 10,
      "depends": [],
      "env": {
        "ROS_DOMAIN_ID": "42",
        "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp"
      },
      "health_check": {
        "enabled": true,
        "restart_on_failure": true,
        "max_restarts": 3
      }
    },
    {
      "name": "startup-wizard",
      "image": "koalby/startup-wizard",
      "version": "latest",
      "essential": true,
      "autostart": true,
      "priority": 20,
      "depends": ["cortex-bridge"],
      "env": {
        "SDL_VIDEODRIVER": "kmsdrm",
        "SDL_AUDIODRIVER": "dummy",
        "ROS_DOMAIN_ID": "42",
        "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp"
      },
      "health_check": {
        "enabled": true,
        "restart_on_failure": true,
        "max_restarts": 3
      },
      "run_condition": "!file_exists:/data/.setup-done"
    },
    {
      "name": "face-ui",
      "image": "koalby/face-ui",
      "version": "latest",
      "essential": true,
      "autostart": true,
      "priority": 20,
      "depends": ["cortex-bridge"],
      "env": {
        "SDL_VIDEODRIVER": "kmsdrm",
        "SDL_AUDIODRIVER": "dummy",
        "ROS_DOMAIN_ID": "42",
        "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp"
      },
      "health_check": {
        "enabled": true,
        "restart_on_failure": true,
        "max_restarts": 3
      },
      "run_condition": "file_exists:/data/.setup-done"
    }
  ]
}
