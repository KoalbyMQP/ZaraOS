#!/bin/sh
# ===================================================================
# $$$$$$$$\                              $$$$$$\   $$$$$$\
# \____$$  |                            $$  __$$\ $$  __$$\
#     $$  / $$$$$$\   $$$$$$\  $$$$$$\  $$ /  $$ |$$ /  \__|
#    $$  /  \____$$\ $$  __$$\ \____$$\ $$ |  $$ |\$$$$$$\
#   $$  /   $$$$$$$ |$$ |  \__|$$$$$$$ |$$ |  $$ | \____$$\
#  $$  /   $$  __$$ |$$ |     $$  __$$ |$$ |  $$ |$$\   $$ |
# $$$$$$$$\\$$$$$$$ |$$ |     \$$$$$$$ | $$$$$$  |\$$$$$$  |
# \________|\_______|\__|      \_______| \______/  \______/
#
# ===================================================================
# rcS - System Initialization Script
# ===================================================================

# Mounts FIRST before anything else
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -o remount,rw /
[ -d /dev/pts ] || mkdir /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp

# Now psplash has a chance of working
psplash < /dev/null &
sleep 1

# Make fifo writes non-blocking so a psplash crash doesn't hang boot
echo "MSG Booting ZaraOS..." > /tmp/psplash-fifo 2>/dev/null || true
echo "PROGRESS 5" > /tmp/psplash-fifo 2>/dev/null || true

# Cgroups
echo "MSG Initializing cgroups..." > /tmp/psplash-fifo || true
mkdir -p /sys/fs/cgroup
mount -t cgroup2 cgroup2 /sys/fs/cgroup
echo "PROGRESS 35" > /tmp/psplash-fifo || true

# Hostname and logging
[ -f /etc/hostname ] && hostname -F /etc/hostname
[ -x /sbin/klogd ] && klogd < /dev/null
[ -x /sbin/syslogd ] && syslogd < /dev/null

# Kernel modules
if [ -d /etc/modules-load.d ]; then
    for conf in /etc/modules-load.d/*.conf; do
        [ -f "$conf" ] || continue
        while read module; do
            case "$module" in
                ""|\#*) continue ;;
            esac
            modprobe $module
        done < "$conf"
    done
fi

# Network
echo "MSG Starting network..." > /tmp/psplash-fifo || true
[ -x /sbin/ifup ] && ifup -a || ifconfig lo up
echo "PROGRESS 50" > /tmp/psplash-fifo || true

# Time sync - background so it doesn't block boot
echo "MSG Syncing time..." > /tmp/psplash-fifo || true
ntpd -p pool.ntp.org < /dev/null &
echo "PROGRESS 65" > /tmp/psplash-fifo || true

# Containerd
echo "MSG Starting container runtime..." > /tmp/psplash-fifo 2>/dev/null || true
containerd < /dev/null &
timeout=15
while [ ! -S /run/containerd/containerd.sock ] && [ $timeout -gt 0 ]; do
    sleep 1
    timeout=$((timeout - 1))
done
echo "PROGRESS 85" > /tmp/psplash-fifo 2>/dev/null || true

# S* scripts
for script in /etc/init.d/S*; do
    [ -x "$script" ] || continue
    "$script" start < /dev/null
done

# 9P host share (QEMU only — mount if available)
if grep -q 9p /proc/filesystems 2>/dev/null; then
    mkdir -p /mnt/host
    mount -t 9p -o trans=virtio host0 /mnt/host 2>/dev/null && \
        echo "Host share mounted at /mnt/host"
fi

echo "PROGRESS 100" > /tmp/psplash-fifo 2>/dev/null || true
sleep 1
echo "QUIT" > /tmp/psplash-fifo 2>/dev/null || true

echo "ZaraOS ready"
