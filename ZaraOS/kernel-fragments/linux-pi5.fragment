CONFIG_ARM64_16K_PAGES=y
CONFIG_ARM64_4K_PAGES=n

# Add Pi 5 hardware support
CONFIG_ARCH_BCM2835=y
CONFIG_BCM2712=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCIE_BRCMSTB=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_I2C=y
CONFIG_SPI=y
CONFIG_PWM=y

# Network drivers
CONFIG_MACB=y
CONFIG_GENET=y

# USB storage
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# Real time monitor
CONFIG_PREEMPT=y
CONFIG_HIGH_RES_TIMERS=y

# Only keep essential filesystems
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y          # Need for boot partition
CONFIG_FAT_FS=y           # Need for boot partition
# Disable everything else
CONFIG_NTFS_FS=n
CONFIG_XFS_FS=n
CONFIG_BTRFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_NILFS2_FS=n
CONFIG_REISERFS_FS=n

# FIXME: this needs to be removed but for now we have keyboard support
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_HID=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_EVDEV=y

# RP1 southbridge (Pi 5 peripheral hub via PCIe)
CONFIG_MFD_RP1=y
CONFIG_PINCTRL_RP1=y
CONFIG_GPIO_RP1=y
