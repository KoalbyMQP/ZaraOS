# 16K pages - Pi 5 optimization
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARM64_4K_PAGES=n

# Filesystem choices
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NTFS_FS=n
CONFIG_XFS_FS=n
CONFIG_BTRFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_NILFS2_FS=n
CONFIG_REISERFS_FS=n

# Performance
CONFIG_PREEMPT=y
CONFIG_HIGH_RES_TIMERS=y

# Keyboard/input support
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_EVDEV=y
CONFIG_PCI_MSI=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y

# Container support
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_OVERLAY_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Disable debug
CONFIG_KGDB=n
CONFIG_KGDB_SERIAL_CONSOLE=n

#Wifi
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMUTIL=y
CONFIG_CRYPTO_ARC4=y
CONFIG_MODULE_DECOMPRESS=y

# Display
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_V3D=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_KMS_HELPER=y

# V3D GPU scheduler - required for V3D on Pi 5
CONFIG_GPU_SCHED=y
CONFIG_DRM_SCHED=y

# DRM GEM helpers needed by vc4/v3d
CONFIG_DRM_GEM_DMA_HELPER=y
CONFIG_DRM_GEM_SHMEM_HELPER=y

# Memory management for GPU
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=64

# DRM panel/bridge helpers (needed for HDMI output)
CONFIG_DRM_PANEL=y
CONFIG_DRM_BRIDGE=y
CONFIG_DRM_PANEL_BRIDGE=y

# HDMI codec
CONFIG_DRM_DISPLAY_HDMI_HELPER=y
CONFIG_HDMI=y

# DMA buffer sharing
CONFIG_DMA_SHARED_BUFFER=y

# Sync primitives for GPU
CONFIG_SYNC_FILE=y
