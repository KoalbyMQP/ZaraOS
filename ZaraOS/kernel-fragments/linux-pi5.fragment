# 16K pages - Pi 5 optimization
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARM64_4K_PAGES=n

# Filesystem choices
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NTFS_FS=n
CONFIG_XFS_FS=n
CONFIG_BTRFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_NILFS2_FS=n
CONFIG_REISERFS_FS=n

# Performance
CONFIG_PREEMPT=y
CONFIG_HIGH_RES_TIMERS=y

# Keyboard/input support
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_EVDEV=y

# Container support
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_OVERLAY_FS=y

# Disable debug
CONFIG_KGDB=n
CONFIG_KGDB_SERIAL_CONSOLE=n

#Wifi
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMUTIL=y
