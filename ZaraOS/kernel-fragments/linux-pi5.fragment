# 16K pages - Pi 5 optimization
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARM64_4K_PAGES=n

# Filesystem choices
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NTFS_FS=n
CONFIG_XFS_FS=n
CONFIG_BTRFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_NILFS2_FS=n
CONFIG_REISERFS_FS=n

# Performance
CONFIG_PREEMPT=y
CONFIG_HIGH_RES_TIMERS=y

# Disable debug
CONFIG_KGDB=n
CONFIG_KGDB_SERIAL_CONSOLE=n
