# ZaraOS QEMU Kernel Configuration Fragment
# Applied when building with: ./build-kernel-local.sh --qemu
#
# This fragment configures the kernel for QEMU's "virt" machine (aarch64).
# Key differences from the Pi 5 fragment:
#   - 4K pages (QEMU virt requires 4K; Pi 5 uses 16K)
#   - Virtio drivers (block, net, console, GPU)
#   - PL011 UART for serial console
#   - 9P filesystem for host directory sharing
#   - No Pi 5 hardware (VC4/V3D GPU, Broadcom WiFi, BCM2835 PWM)

# Page size: 4K required for QEMU virt machine
CONFIG_ARM64_4K_PAGES=y
# CONFIG_ARM64_16K_PAGES is not set
# CONFIG_ARM64_64K_PAGES is not set

# Disable loadable modules — build everything into the kernel.
# This avoids macOS uuid_t typedef conflicts in modpost (the kernel's
# module post-processing tool) and simplifies QEMU testing.
CONFIG_MODULES=n

# ── Virtio drivers (QEMU virtual hardware) ──────────────────────
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_SCSI_VIRTIO=y

# ── Serial console (PL011 UART used by QEMU virt) ───────────────
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# ── Initramfs support ───────────────────────────────────────────
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# ── Device management ───────────────────────────────────────────
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ── Filesystem choices ──────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# ── 9P filesystem for host directory sharing ────────────────────
# Mount in VM with: mount -t 9p -o trans=virtio host0 /mnt
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# ── Performance ─────────────────────────────────────────────────
CONFIG_PREEMPT=y
CONFIG_HIGH_RES_TIMERS=y

# ── Keyboard/input support ──────────────────────────────────────
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_EVDEV=y

# ── Container support (shared with Pi 5) ────────────────────────
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_OVERLAY_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ── Networking ──────────────────────────────────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y

# ── Disable hardware not present in QEMU virt ──────────────────
# Pi 5 GPU and display
CONFIG_DRM_VC4=n
CONFIG_DRM_V3D=n
CONFIG_GPU_SCHED=n
CONFIG_DRM_SCHED=n
CONFIG_PWM_BCM2835=n
CONFIG_CMA=n
CONFIG_DMA_CMA=n
# Broadcom WiFi
CONFIG_BRCMFMAC=n
CONFIG_BRCMUTIL=n

# ── Disable drivers that cause macOS build issues ──────────────
# (case-insensitive filesystem conflicts, unnecessary for QEMU)
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_CFG80211=n
CONFIG_MAC80211=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_I915=n
CONFIG_DRM_MSM=n

# ── Disable KVM (not usable from macOS host) ───────────────────
CONFIG_KVM=n

# ── Disable debug ──────────────────────────────────────────────
CONFIG_KGDB=n
CONFIG_KGDB_SERIAL_CONSOLE=n
