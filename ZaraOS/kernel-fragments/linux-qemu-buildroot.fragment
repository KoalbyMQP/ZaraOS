# ZaraOS QEMU Kernel Configuration Fragment (Buildroot variant)
# ==============================================================
# Used when building with Buildroot for QEMU testing.
# Unlike linux-qemu.fragment (designed for macOS local builds),
# this variant:
#   - Keeps CONFIG_MODULES=y (same as production Pi 5)
#   - Doesn't need macOS workarounds (Buildroot builds on Linux)
#   - Enables DRM fbdev emulation (so psplash works on virtio-gpu)
#
# Applied by: configs/zaraos_qemu_defconfig

# ── Page size: 4K required for QEMU virt machine ──────────────
CONFIG_ARM64_4K_PAGES=y
# CONFIG_ARM64_16K_PAGES is not set
# CONFIG_ARM64_64K_PAGES is not set

# ── Modules: ENABLED (matches production for 1:1 parity) ──────
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ── Virtio drivers (QEMU virtual hardware) ────────────────────
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SCSI_VIRTIO=y

# ── Display: virtio-gpu with framebuffer emulation ─────────────
# psplash writes to /dev/fb0, so we need DRM fbdev emulation
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_FB=y

# ── Serial console (PL011 UART used by QEMU virt) ─────────────
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# ── Initramfs support ─────────────────────────────────────────
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# ── Device management ─────────────────────────────────────────
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ── Filesystem choices ────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# ── 9P filesystem for host directory sharing ──────────────────
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# ── Performance ───────────────────────────────────────────────
CONFIG_PREEMPT=y
CONFIG_HIGH_RES_TIMERS=y

# ── Keyboard/input support ────────────────────────────────────
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_EVDEV=y

# ── Container support (identical to Pi 5 fragment) ────────────
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_OVERLAY_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NF_NAT=y
CONFIG_POSIX_MQUEUE=y

# ── Networking ────────────────────────────────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y

# ── Disable Pi 5 hardware not present in QEMU ────────────────
CONFIG_DRM_VC4=n
CONFIG_DRM_V3D=n
CONFIG_GPU_SCHED=n
CONFIG_DRM_SCHED=n
CONFIG_PWM_BCM2835=n
CONFIG_BRCMFMAC=n
CONFIG_BRCMUTIL=n

# ── Disable debug ────────────────────────────────────────────
CONFIG_KGDB=n
CONFIG_KGDB_SERIAL_CONSOLE=n
