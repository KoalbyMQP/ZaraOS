# ===================================================================
# ZaraOS Image Generation Configuration
# Partitions: boot (FAT32) | rootfs-a (EXT4) | rootfs-b (EXT4) | data (EXT4)
# rootfs-b is a copy of rootfs-a at flash time; data is expanded on first boot.
# ===================================================================

image boot.vfat {
	vfat {
		files = {
#BOOT_FILES#
		}

		file overlays {
			image = "overlays"
		}
	}

	size = 100M
}

# Small placeholder data partition - S02-first-boot.sh expands it to fill the card
image data.ext4 {
	ext4 {
		label = "zaraos-data"
	}
	size = 64M
}

image sdcard.img {
	hdimage {}

	# p1 - boot (FAT32, bootable)
	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	# p2 - rootfs slot A (active on first flash)
	partition rootfs-a {
		partition-type = 0x83
		image = "rootfs.ext4"
	}

	# p3 - rootfs slot B (copy of A at flash time, target for OTA updates)
	partition rootfs-b {
		partition-type = 0x83
		image = "rootfs-b.ext4"
	}

	# p4 - persistent data: containerd images, config, update staging
	#      expanded to fill remaining card space on first boot
	partition data {
		partition-type = 0x83
		image = "data.ext4"
	}
}
